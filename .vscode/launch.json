{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/as",
            "args": ["test.as"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "internalConsoleOptions": "openOnSessionStart",
            "MIMode": "gdb",
            "preLaunchTask": "build"
        },
        {
            "name": "Debug lldb",
            "type": "lldb",                // Nutzt die installierte CodeLLDB-Erweiterung
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/paz",
            "args": ["test.as"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build"        // Führt deinen Build-Task vor dem Debuggen aus
        },
        {
            "name": "Debug lldb - debug-vm",
            "type": "lldb",                // Nutzt die installierte CodeLLDB-Erweiterung
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/paz",
            "args": ["test.as", "--debug-vm"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build"        // Führt deinen Build-Task vor dem Debuggen aus
        }
    ]
}
